# 이 파일을 backend/.env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# 운영에서는 GitHub Actions 비밀값(Settings > Secrets and variables > Actions)에 같은 이름으로 등록한다.

# --- 필수: Supabase PostgreSQL 연결 문자열 (세션 방식 중계기, 포트 5432) ---
# Supabase > Project Settings > Database > Connection string > Session pooler
KHU_DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- 필수: Cloudflare R2 (S3 호환) ---
KHU_R2_ACCOUNT_ID=
KHU_R2_ACCESS_KEY_ID=
KHU_R2_SECRET_ACCESS_KEY=
KHU_R2_BUCKET_PUBLIC=khu-notice-public
KHU_R2_BUCKET_EVIDENCE=khu-notice-evidence
KHU_R2_BUCKET_BACKUP=khu-notice-backup

# --- 선택: 외부 감시 서비스의 완료 신호 주소 (healthchecks.io 등) ---
KHU_HEARTBEAT_URL=

# --- 실행 조절 ---
KHU_ENV=development
KHU_RUN_BUDGET_SECONDS=1800
KHU_HTTP_CONCURRENCY=5
KHU_HTTP_DELAY_SECONDS=2.0
KHU_HTTP_TIMEOUT_SECONDS=25
KHU_MAX_RESPONSE_BYTES=8000000
KHU_USER_AGENT=khu-notice-bot/0.1 (+https://github.com/sihort183-creator/khu)
KHU_DRY_RUN=0
