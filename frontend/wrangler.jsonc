{
  // 화면 배포 설정. 조회 서버(worker/)와는 별개의 Worker 다.
  // 배포: npx opennextjs-cloudflare build && npx opennextjs-cloudflare deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khu-notice-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // 새 도메인을 붙여도 workers.dev 주소를 끄지 않는다(routes 를 주면 기본이 꺼짐).
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // 산 도메인(경희공지.info). 화면은 맨 앞 주소와 www 둘 다 받는다. workers.dev 주소도 그대로 둔다.
  "routes": [
    { "pattern": "xn--289a5d743g7dm.info", "custom_domain": true },
    { "pattern": "www.xn--289a5d743g7dm.info", "custom_domain": true }
  ]
}
